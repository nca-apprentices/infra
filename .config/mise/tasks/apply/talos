#!/usr/bin/env bash
#MISE description="Show how talos/patch.yaml differs from the node, then apply it"
set -euo pipefail

ip=$(mise run tofu:output node_ipv4)
export TALOSCONFIG=${TALOSCONFIG:-$(dirname "$KUBECONFIG")/talosconfig}

# The node config only, in a scratch directory, so the talosconfig that
# `mise run apply:cloud` generated stays as it is.
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

sops exec-file talos/secrets.sops.yaml "mise run talos:config {} $scratch"

# The dry run prints the difference to the running configuration and
# changes nothing.
talosctl -e "$ip" -n "$ip" apply-config --dry-run --file "$scratch/nca-nca-1.yaml"

read -rp "Apply this? [y/N] " answer
if [[ $answer != y ]]; then
  exit 1
fi
talosctl -e "$ip" -n "$ip" apply-config --file "$scratch/nca-nca-1.yaml"
