#!/usr/bin/env bash
#MISE description="Validate tofu, Talos and the cluster manifests, without credentials"
set -euo pipefail

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# Every secret is SOPS-encrypted, so a plaintext one fails here before it
# merges. A YAML file carries sops.mac, a dotenv file sops_mac.
plaintext=0
while IFS= read -r file; do
  case $file in
  *.env) grep -q '^sops_mac=' "$file" && continue ;;
  *) yq -e '.sops.mac' "$file" >/dev/null 2>&1 && continue ;;
  esac
  echo "not encrypted: $file" >&2
  plaintext=1
done < <(find secrets talos -type f \( -name '*.enc.*' -o -name '*.sops.*' -o -path 'secrets/*' \) ! -name sopssecret.yq)
if ((plaintext)); then
  exit 1
fi

treefmt --ci
mise run check:prose

# Secrets in plain text anywhere in the history, not only in secrets/, and
# workflows that leak tokens or run unpinned actions.
gitleaks git --no-banner --redact .
actionlint
zizmor --offline .github/workflows

# A data directory of its own, so an operator's initialized backend in
# tofu/.terraform doesn't make validation ask for state credentials.
TF_DATA_DIR="$scratch/tofu" tofu -chdir=tofu init -backend=false -input=false >/dev/null
TF_DATA_DIR="$scratch/tofu" tofu -chdir=tofu validate

# A throwaway secret is enough to prove the config renders and is valid.
talhelper gensecret >"$scratch/talsecret.yaml"
# Offline: the schematic ID is a hash of the schematic, so validation doesn't
# need factory.talos.dev, whose handshake times out now and then and failed CI.
talhelper genconfig --offline-mode \
  --config-file talos/talconfig.yaml \
  --secret-file "$scratch/talsecret.yaml" \
  --out-dir "$scratch/clusterconfig" >/dev/null
for node in "$scratch"/clusterconfig/*.yaml; do
  talosctl validate --config "$node" --mode cloud --strict
done

# Custom resources validate against the community CRD catalog. Kinds missing
# from it are skipped rather than failed.
kubeconform=(
  kubeconform -strict -summary -ignore-missing-schemas
  -schema-location default
  -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json'
)
kustomize build cluster/bootstrap | "${kubeconform[@]}"
# The stores, network, and database directories hold Helm values, and charts
# holds templates, not manifests.
"${kubeconform[@]}" \
  -ignore-filename-pattern '/stores/' \
  -ignore-filename-pattern '/network/' \
  -ignore-filename-pattern '/database/values' \
  -ignore-filename-pattern '/charts/' \
  cluster/platform cluster/apps

# Every third-party chart renders with the values its Application passes. The
# jjforge chart is checked by the app CI before it is released.
for app in cluster/platform/*.yaml cluster/apps/*/*/*.yaml; do
  chart=$(yq '.spec.source.chart // ""' "$app")
  if [[ -z $chart ]]; then
    continue
  fi

  yq '.spec.source.helm.values // .spec.source.helm.valuesObject // {}' "$app" |
    helm template "$(yq .metadata.name "$app")" "$chart" \
      --repo "$(yq .spec.source.repoURL "$app")" \
      --version "$(yq .spec.source.targetRevision "$app")" \
      --namespace "$(yq .spec.destination.namespace "$app")" \
      --values - |
    "${kubeconform[@]}"
done

# Every environment's store renders with the shared values and its own, as its
# ApplicationSet in cluster/platform passes them.
for values in cluster/apps/*/*/stores/*.yaml; do
  store=$(basename "$values" .yaml)
  set=cluster/platform/$store.yaml
  source=.spec.template.spec.sources[0]
  IFS=/ read -r _ _ app env _ <<<"$values"

  helm template "$store" "$(yq "$source.chart" "$set")" \
    --repo "$(yq "$source.repoURL" "$set")" \
    --version "$(yq "$source.targetRevision" "$set")" \
    --namespace "$app-$env" \
    --values "cluster/platform/stores/$store.yaml" \
    --values "$values" |
    "${kubeconform[@]}"
done

# Every environment's network policies render from the chart with its values,
# as the network ApplicationSet passes them.
for values in cluster/apps/*/*/network/values.yaml; do
  IFS=/ read -r _ _ app env _ <<<"$values"
  helm template network cluster/platform/charts/network \
    --namespace "$app-$env" --values "$values" |
    "${kubeconform[@]}"
done

# Every environment's database renders from the chart with its values.
for values in cluster/apps/*/*/database/values.yaml; do
  IFS=/ read -r _ _ app env _ <<<"$values"
  helm template database cluster/platform/charts/database \
    --namespace "$app-$env" --values "$values" |
    "${kubeconform[@]}"
done

# A preview's namespace renders from its chart, as environment.yaml in
# apps/jjforge/preview passes it.
helm template preview cluster/platform/charts/preview --namespace jjforge-pr-1 |
  "${kubeconform[@]}"
