#!/usr/bin/env bash
#MISE description="Upgrade Kubernetes to the release in talos/versions.yaml"
set -euo pipefail

ip=$(mise run tofu:output node_ipv4)
export TALOSCONFIG=${TALOSCONFIG:-$(dirname "$KUBECONFIG")/talosconfig}

# Without --endpoint, upgrade-k8s dials the API server at the private address
# in the cluster config and times out.
version=$(yq -e .kubernetes talos/versions.yaml)
talosctl -e "$ip" -n "$ip" upgrade-k8s \
  --to "$version" \
  --endpoint "https://$ip:6443"
