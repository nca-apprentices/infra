#!/usr/bin/env bash
#MISE description="Re-encrypt every secret to the keys its rule in .sops.yaml lists"
set -euo pipefail

# Run after a key is added to or removed from .sops.yaml. A file whose keys
# already match stays as it is.
for f in $(find secrets -name '*.enc.*') talos/secrets.sops.yaml; do
  sops updatekeys --yes "$f"
done
