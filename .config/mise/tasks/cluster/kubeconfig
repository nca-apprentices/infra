#!/usr/bin/env bash
#MISE description="Write the kubeconfig that kubectl and the tasks use, pointed at the node's public address"
set -euo pipefail

# The address comes from the tofu state, so it stays out of this public
# repository. The talosconfig is rendered into a scratch directory, so the
# task works on a fresh clone with the sops key alone.
ip=$(mise run tofu:output node_ipv4)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
sops exec-file talos/secrets.sops.yaml "mise run talos:config {} $scratch"

# The fetched kubeconfig names the private address, so the public one
# replaces it.
mkdir -p "$(dirname "$KUBECONFIG")"
talosctl --talosconfig "$scratch/talosconfig" -e "$ip" -n "$ip" kubeconfig --force "$KUBECONFIG"
kubectl config set-cluster nca --server "https://$ip:6443" >/dev/null
