# Turns a Secret manifest into a SopsSecret of the same name and namespace,
# which sops-secrets-operator turns back into that Secret. The labels, the
# annotations, and the type carry over. The data becomes stringData, so
# `sops edit` shows each value as text. Pipe the output of
# `kubectl create secret ... --dry-run=client -o yaml` through
# `yq --from-file secrets/sopssecret.yq`, then encrypt the result.
{
  "apiVersion": "isindir.github.com/v1alpha3",
  "kind": "SopsSecret",
  "metadata": {"name": .metadata.name, "namespace": .metadata.namespace},
  "spec": {
    "secretTemplates": [
      {"name": .metadata.name}
      + (.metadata | with_entries(select(.key == "labels" or .key == "annotations")))
      + with_entries(select(.key == "type"))
      + {"stringData": ((.data // {} | map_values(@base64d)) + (.stringData // {}))}
    ]
  }
}
