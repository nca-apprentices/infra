{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>nca-apprentices/.github"],
  "rangeStrategy": "pin",
  "argocd": {
    "managerFilePatterns": ["/^cluster/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^cluster/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "Images in our manifests and Dockerfiles pin a digest, so a moved tag changes nothing until a PR says so. Argo CD charts keep their version, which targetRevision can't hold as a digest.",
      "matchManagers": ["kubernetes", "dockerfile"],
      "pinDigests": true
    },
    {
      "description": "Everything else arrives as one PR per schedule window.",
      "matchPackageNames": ["*"],
      "groupName": "dependencies",
      "separateMajorMinor": false
    },
    {
      "description": "Our own releases deploy when they are published.",
      "matchPackageNames": ["ghcr.io/nca-apprentices/**"],
      "groupName": null,
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    },
    {
      "description": "Dev takes our releases without review. Renovate merges the PR itself, through its ruleset bypass, because GitHub auto-merge would wait for the review.",
      "matchPackageNames": ["ghcr.io/nca-apprentices/**"],
      "matchFileNames": ["cluster/apps/*/dev/**"],
      "additionalBranchPrefix": "dev-",
      "commitMessageSuffix": "in dev",
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": "Prod takes our releases through a reviewed PR.",
      "matchPackageNames": ["ghcr.io/nca-apprentices/**"],
      "matchFileNames": ["cluster/apps/*/prod/**"],
      "additionalBranchPrefix": "prod-",
      "commitMessageSuffix": "in prod"
    },
    {
      "description": "The node's Talos and the talosctl that upgrades it move together. One PR per minor version, since a node upgrades one minor at a time.",
      "matchDepNames": ["siderolabs/talos", "talosctl"],
      "groupName": "Talos",
      "separateMultipleMinor": true
    },
    {
      "description": "Kubernetes and kubectl move together. One PR per minor version, since a node upgrades one minor at a time.",
      "matchDepNames": ["kubernetes/kubernetes", "kubectl"],
      "groupName": "Kubernetes",
      "separateMultipleMinor": true
    },
    {
      "description": "The installed Argo CD and the chart the diff renders with move together.",
      "matchDepNames": ["argoproj/argo-cd", "argo-cd"],
      "groupName": "Argo CD"
    },
    {
      "description": "The approver's commit and image move together, through the custom managers below, not the argocd manager.",
      "matchDepNames": [
        "https://github.com/alex1989hu/kubelet-serving-cert-approver.git"
      ],
      "matchManagers": ["argocd"],
      "enabled": false
    },
    {
      "description": "The approver's release commit and its image.",
      "matchDepNames": [
        "alex1989hu/kubelet-serving-cert-approver",
        "ghcr.io/alex1989hu/kubelet-serving-cert-approver"
      ],
      "groupName": "kubelet-serving-cert-approver"
    },
    {
      "description": "A new Postgres major needs a migration, not a new image, so only minors and patches arrive.",
      "matchDepNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "required_version in tofu/ constrains OpenTofu, which mise.toml pins, not Terraform, whose versions Renovate would write there.",
      "matchDepNames": ["hashicorp/terraform"],
      "enabled": false
    },
    {
      "description": "Cilium upgrades to the latest patch of its minor version first, then one minor at a time, each in a PR of its own.",
      "matchDepNames": ["cilium"],
      "groupName": null,
      "separateMinorPatch": true,
      "separateMultipleMinor": true
    },
    {
      "description": "Redpanda can't skip a feature release, and since chart 25.1 the chart's minor version is Redpanda's. Each minor arrives as its own PR, to merge oldest first.",
      "matchDepNames": ["redpanda"],
      "groupName": null,
      "separateMultipleMajor": true,
      "separateMultipleMinor": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Talos version the node runs.",
      "managerFilePatterns": ["/^talos/talconfig\\.yaml$/"],
      "matchStrings": ["talosVersion: (?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos"
    },
    {
      "customType": "regex",
      "description": "The Kubernetes version the node runs.",
      "managerFilePatterns": ["/^talos/talconfig\\.yaml$/"],
      "matchStrings": ["kubernetesVersion: (?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes"
    },
    {
      "customType": "regex",
      "description": "The Argo CD that bootstrap installs.",
      "managerFilePatterns": ["/^cluster/bootstrap/kustomization\\.yaml$/"],
      "matchStrings": [
        "argoproj/argo-cd/(?<currentValue>v[\\d.]+)/manifests/install\\.yaml"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "argoproj/argo-cd"
    },
    {
      "customType": "regex",
      "description": "The Argo CD chart the PR diff renders with.",
      "managerFilePatterns": ["/^\\.github/workflows/diff\\.yml$/"],
      "matchStrings": ["ARGOCD_CHART_VERSION=(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm",
      "depNameTemplate": "argo-cd"
    },
    {
      "customType": "regex",
      "description": "The Postgres image of every database cluster.",
      "managerFilePatterns": [
        "/^cluster/platform/charts/database/templates/cluster\\.yaml$/"
      ],
      "matchStrings": [
        "imageName: (?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The approver's release, pinned to its commit.",
      "managerFilePatterns": ["/^cluster/platform/kubelet-serving-cert-approver\\.yaml$/"],
      "matchStrings": [
        "targetRevision: (?<currentDigest>[0-9a-f]{40}) # (?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "alex1989hu/kubelet-serving-cert-approver"
    },
    {
      "customType": "regex",
      "description": "The approver's image, pinned to its digest.",
      "managerFilePatterns": ["/^cluster/platform/kubelet-serving-cert-approver\\.yaml$/"],
      "matchStrings": [
        "- (?<depName>ghcr\\.io/alex1989hu/kubelet-serving-cert-approver)@(?<currentDigest>sha256:[0-9a-f]{64}) # (?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Images with a fixed tag in the mise tasks, such as rclone in restore.",
      "managerFilePatterns": ["/^\\.config/mise/tasks/[^/]+$/"],
      "matchStrings": [
        "image: (?<depName>[a-z0-9./-]+):(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
