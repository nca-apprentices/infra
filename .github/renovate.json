{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>nca-apprentices/.github"],
  "rangeStrategy": "pin",
  "argocd": {
    "managerFilePatterns": ["/^cluster/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^cluster/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "Images in our manifests pin a digest, so a moved tag changes nothing until a PR says so. Argo CD charts keep their version, which targetRevision can't hold as a digest.",
      "matchManagers": ["kubernetes"],
      "pinDigests": true
    },
    {
      "description": "Everything else arrives as one PR per schedule window.",
      "matchPackageNames": ["*"],
      "groupName": "dependencies",
      "separateMajorMinor": false
    },
    {
      "description": "Our own releases deploy when they are published.",
      "matchPackageNames": ["ghcr.io/nca-apprentices/**"],
      "groupName": null,
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    },
    {
      "description": "Dev takes our releases without review. Renovate merges the PR itself, through its ruleset bypass, because GitHub auto-merge would wait for the review.",
      "matchPackageNames": ["ghcr.io/nca-apprentices/**"],
      "matchFileNames": ["cluster/apps/*/dev/**"],
      "additionalBranchPrefix": "dev-",
      "commitMessageSuffix": "in dev",
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": "Prod takes our releases through a reviewed PR.",
      "matchPackageNames": ["ghcr.io/nca-apprentices/**"],
      "matchFileNames": ["cluster/apps/*/prod/**"],
      "additionalBranchPrefix": "prod-",
      "commitMessageSuffix": "in prod"
    }
  ]
}
